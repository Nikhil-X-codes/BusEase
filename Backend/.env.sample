PORT=8000
MONGODB_URI=your_mongodb_connection_string
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d
CORS_ORIGIN=http://localhost:5173

# Redis Configuration (Optional for local development, recommended for production)
# Leave blank to use built-in in-memory fallback, or provide local/cloud Redis URL:
# Local Docker: redis://localhost:6379
# Cloud (Upstash/Redis Cloud): rediss://default:password@endpoint.upstash.io:6379
REDIS_URL=

EMAIL_USER=your_email
EMAIL_PASS=your_password